{
  "name": "@xdb/web",
  "version": "0.0.1",
  "description": "A local web database client for PostgreSQL, MySQL, and SQLite built with Node, React, and Vite.",
  "author": "Daniel Caldera",
  "homepage": "https://github.com/dancaldera/xdb",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/lib-storage": "^3.1117.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@tursodatabase/serverless": "^1.1.3",
    "@uiw/react-codemirror": "^4.23.8",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.34.0",
    "mysql2": "^3.24.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
